# ============================================================
# docker compose 环境变量模板
#
#   cp .env.example .env
#   然后填写下面所有「必填」项 —— 没有默认值，缺任何一个 compose 都会直接报错退出
#
# .env 已被 .gitignore 忽略，不会入库。**不要**把真实密钥提交到仓库。
# ============================================================

# ---- 对外访问端口（可选，默认 8080）----
# 浏览器访问 http://localhost:<WEB_PORT>
WEB_PORT=8080

# ---- MySQL（必填）----
# 业务账号密码。app 会以该账号连接数据库
MYSQL_PASSWORD=
# root 密码，仅用于容器初始化与健康检查
MYSQL_ROOT_PASSWORD=
# 以下两项可选，默认 gin
MYSQL_DATABASE=gin
MYSQL_USER=gin

# ---- Redis（必填）----
REDIS_PASSWORD=

# ---- JWT（必填）----
# 签名密钥。**必须是强随机值**：用它可伪造任意用户的 token。
# 生成方式（任选其一）：
#   openssl rand -base64 48
#   openssl rand -hex 32
#   head -c 32 /dev/urandom | xxd -p
# 注意：生产环境（mode=release）若仍是默认值 "change-me-in-production"
#      或为空，服务会**拒绝启动**（见 config.ValidateSecurity）；
#      mode=debug 下只会打印告警（见 config.DevelopmentWarnings），
#      而默认密钥 + 监听所有网卡意味着同网段任何人都能伪造 token 登录。
JWT_SECRET=
