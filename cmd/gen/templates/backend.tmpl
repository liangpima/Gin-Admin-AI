type [[.Pascal]]Service interface {
	Create(req *dto.Create[[.Pascal]]Request, operatorID, tenantID uint) error
	Update(req *dto.Update[[.Pascal]]Request, operatorID, tenantID uint) error
	Delete(tenantID, id uint) error
	FindByID(tenantID, id uint) (*model.[[.Pascal]], error)
	FindList(tenantID uint, req *dto.[[.Pascal]]ListRequest) ([]model.[[.Pascal]], int64, error)
}

type [[.Camel]]Service struct {
	repo repository.[[.Pascal]]Repository
}

func New[[.Pascal]]Service() [[.Pascal]]Service {
	return &[[.Camel]]Service{repo: repository.New[[.Pascal]]Repository()}
}

// Create 创建[[.Title]]。
//
// 业务校验失败必须用 common.NewBizError("..."): 它对外是 400 + 原文案
// （用户看得懂、也知道该改什么）。直接 `return err` 会被 FailWith 归到
// 系统错误 → 对外只剩「服务器内部错误」+ 500，用户完全不知道发生了什么。
// 反之，DB / IO 失败**不要**包装成 BizError —— 那会把 5xx 说成 4xx，
// 让监控失去告警能力。
func (s *[[.Camel]]Service) Create(req *dto.Create[[.Pascal]]Request, operatorID, tenantID uint) error {
	item := &model.[[.Pascal]]{
		Name:   req.Name,
		Status: req.Status,
		Sort:   req.Sort,
	}
	item.TenantID = tenantID
	item.CreateBy = operatorID
	item.UpdateBy = operatorID
	item.Remark = req.Remark

	return s.repo.Create(item)
}

// Update 部分更新：只覆盖显式提供的字段。
//
// 无条件赋值会把未提供的字段清成零值 —— 表现为「只改名称，状态被重置」。
func (s *[[.Camel]]Service) Update(req *dto.Update[[.Pascal]]Request, operatorID, tenantID uint) error {
	item, err := s.FindByID(tenantID, req.ID)
	if err != nil {
		// 只把 gorm.ErrRecordNotFound 转成 404，其余（连接断开等）
		// 原样透出成 500 —— 否则 DB 故障会被报成「记录不存在」，
		// 用户按提示反复重试，而监控里一条 5xx 都没有。
		return common.NotFoundOrErr(err, "记录不存在")
	}

	if req.Name != "" {
		item.Name = req.Name
	}
	if req.Status != nil {
		item.Status = *req.Status
	}
	if req.Sort != nil {
		item.Sort = *req.Sort
	}
	if req.Remark != nil {
		item.Remark = *req.Remark
	}
	item.UpdateBy = operatorID

	return s.repo.Update(tenantID, item)
}

func (s *[[.Camel]]Service) Delete(tenantID, id uint) error {
	return common.NotFoundOrErr(s.repo.Delete(tenantID, id), "记录不存在")
}

func (s *[[.Camel]]Service) FindByID(tenantID, id uint) (*model.[[.Pascal]], error) {
	item, err := s.repo.FindByID(tenantID, id)
	if err != nil {
		return nil, common.NotFoundOrErr(err, "记录不存在")
	}
	return item, nil
}

func (s *[[.Camel]]Service) FindList(tenantID uint, req *dto.[[.Pascal]]ListRequest) ([]model.[[.Pascal]], int64, error) {
	page, pageSize := common.NormalizePageParams(req.Page, req.PageSize)
	return s.repo.FindList(tenantID, req.Name, page, pageSize)
}
