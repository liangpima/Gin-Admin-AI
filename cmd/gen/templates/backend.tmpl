[[define "repository"]]package repository

import (
	"go-admin/internal/common"
	"go-admin/internal/database"
	"go-admin/internal/module/[[.Name]]/model"

	"gorm.io/gorm"
)

// [[.Pascal]]Repository [[.Title]]的数据访问层。
//
// ⚠️ 每个方法都带 tenantID 是**刻意**的：本项目的表按 TenantBaseModel
// 隔离，而 common.TenantScope(db, 0) 表示「不过滤」（平台级账号的语义）。
// 也就是说**漏传 tenantID 会静默退化成全表查询**，直接造成跨租户数据泄漏。
// 把它放进签名是从类型层面强制，不依赖调用方记得传。
type [[.Pascal]]Repository interface {
	Create(item *model.[[.Pascal]]) error
	Update(tenantID uint, item *model.[[.Pascal]]) error
	Delete(tenantID, id uint) error
	FindByID(tenantID, id uint) (*model.[[.Pascal]], error)
	FindList(tenantID uint, name string, page, pageSize int) ([]model.[[.Pascal]], int64, error)
}

type [[.Camel]]Repository struct{}

func New[[.Pascal]]Repository() [[.Pascal]]Repository {
	return &[[.Camel]]Repository{}
}

// Create 创建。TenantID 由 Service 层赋值 —— Controller 拿不到也不该拿。
func (r *[[.Camel]]Repository) Create(item *model.[[.Pascal]]) error {
	return database.DB.Create(item).Error
}

// Update 更新。先按租户确认记录归属，再保存：
// 直接 Save 会让别租户的 ID 也能被改写（越权写入）。
func (r *[[.Camel]]Repository) Update(tenantID uint, item *model.[[.Pascal]]) error {
	var count int64
	if err := common.TenantScope(database.DB, tenantID).
		Model(&model.[[.Pascal]]{}).
		Where("id = ?", item.ID).
		Count(&count).Error; err != nil {
		return err
	}
	if count == 0 {
		return gorm.ErrRecordNotFound
	}
	return database.DB.Save(item).Error
}

// Delete 软删除。受租户过滤，命中 0 行即返回 ErrRecordNotFound（→ 404）。
func (r *[[.Camel]]Repository) Delete(tenantID, id uint) error {
	res := common.TenantScope(database.DB, tenantID).
		Where("id = ?", id).
		Delete(&model.[[.Pascal]]{})
	if res.Error != nil {
		return res.Error
	}
	if res.RowsAffected == 0 {
		return gorm.ErrRecordNotFound
	}
	return nil
}

func (r *[[.Camel]]Repository) FindByID(tenantID, id uint) (*model.[[.Pascal]], error) {
	var item model.[[.Pascal]]
	err := common.TenantScope(database.DB, tenantID).Where("id = ?", id).First(&item).Error
	if err != nil {
		return nil, err
	}
	return &item, nil
}

func (r *[[.Camel]]Repository) FindList(tenantID uint, name string, page, pageSize int) ([]model.[[.Pascal]], int64, error) {
	var items []model.[[.Pascal]]
	var total int64

	query := common.TenantScope(database.DB, tenantID).Model(&model.[[.Pascal]]{})
	if name != "" {
		// EscapeLike：不转义时用户输入的 % / _ 会被当通配符，
		// 搜 "100%" 会匹配到一大堆无关记录
		query = query.Where("name LIKE ?", "%"+common.EscapeLike(name)+"%")
	}

	if err := query.Count(&total).Error; err != nil {
		return nil, 0, err
	}
	err := query.Order("sort ASC, id DESC").
		Offset((page - 1) * pageSize).Limit(pageSize).
		Find(&items).Error
	return items, total, err
}
